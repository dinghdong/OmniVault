# ── AI Provider ──────────────────────────────────────────────────────────────
# Gemini (default) or OpenAI-compatible
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Main Chain (0G Galileo Testnet) ──────────────────────────────────────────
# RPC endpoint for the chain where OmniVault contracts are deployed
# 0G Galileo Testnet (chainId: 16600)
RPC_URL=https://evmrpc-testnet.0g.ai

# Deployed contract addresses
INVESTMENT_MANAGER_ADDRESS=0x...
AGENT_VOTING_ADDRESS=0x...

# ── AI Agent Wallets ─────────────────────────────────────────────────────────
# Three independent agent wallets — each must be registered in AgentRegistry.
# Each wallet signs an on-chain agentVote() transaction after analysis.
#
# Register with:
#   await registry.addAgent(agent1Wallet.address)
#   await registry.addAgent(agent2Wallet.address)
#   await registry.addAgent(agent3Wallet.address)
#   await im.grantRole(await im.AI_ORACLE_ROLE(), agentVotingAddress)
#
AGENT1_PRIVATE_KEY=0x...   # PitchDeck analysis agent
AGENT2_PRIVATE_KEY=0x...   # Risk assessment agent
AGENT3_PRIVATE_KEY=0x...   # Business analysis agent

# ── 0G Storage (Decentralised AI Report Storage) ──────────────────────────────
# Wallet used to pay gas for uploading audit reports to 0G Storage.
# Must hold 0G testnet tokens — get from: https://faucet.0g.ai
#
# Can be any wallet (does NOT need to be one of the agent wallets).
# If not set, the system falls back to local SHA-256 hashing (no 0G upload).
ZG_STORAGE_PRIVATE_KEY=0x...

# 0G network endpoints (defaults shown — testnet)
ZG_EVM_RPC=https://evmrpc-testnet.0g.ai
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# ── Governance Timing ─────────────────────────────────────────────────────────
# Override delays for local testing (in milliseconds).
# Production values match on-chain constants:
#   COMMUNITY_WINDOW = 48 hours = 172800000 ms
#   EXECUTION_DELAY  = 72 hours = 259200000 ms
#
# Example for fast local E2E testing:
#   COMMUNITY_WINDOW_MS=10000    (10 seconds)
#   EXECUTION_DELAY_MS=15000     (15 seconds)
COMMUNITY_WINDOW_MS=172800000
EXECUTION_DELAY_MS=259200000

# Per-agent approval threshold (basis points, default 6000 = 60%)
# Each specialist agent approves if their domain score >= this value.
AGENT_APPROVAL_THRESHOLD=6000

# ETH amount to invest per approved project (default: 1 ETH)
INVESTMENT_AMOUNT_ETH=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

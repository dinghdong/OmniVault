# ── AI Provider ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── On-Chain Listener (Route A) ───────────────────────────────
# RPC endpoint for the chain where contracts are deployed
RPC_URL=http://127.0.0.1:8545

# Private key of the wallet that holds AI_ORACLE_ROLE on InvestmentManager
# Grant with: await im.grantRole(await im.AI_ORACLE_ROLE(), oracleWallet.address)
ORACLE_PRIVATE_KEY=0x...

# Address of the deployed InvestmentManager contract
INVESTMENT_MANAGER_ADDRESS=0x...

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

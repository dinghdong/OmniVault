# ── Deployment (0G Galileo Testnet) ──────────────────────────────────────────
# Deployer wallet private key (needs OG testnet tokens)
# Get tokens: https://faucet.0g.ai
DEPLOYER_PRIVATE_KEY=0x...

# Agent wallet addresses (derived from AGENT*_PRIVATE_KEY in ai-service/.env)
# Used by deploy.ts to register agents in AgentRegistry
AGENT1_ADDRESS=0x...
AGENT2_ADDRESS=0x...
AGENT3_ADDRESS=0x...

# ── AI Provider ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Deployment (Ethereum Sepolia) ─────────────────────────────────────────────
# Deployer wallet private key
# Get Sepolia ETH: https://sepoliafaucet.com
PRIVATE_KEY=0x...

# Sepolia RPC URL (optional, defaults to public RPC)
# Recommended: Alchemy / Infura for reliability
# https://dashboard.alchemy.com  |  https://app.infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Chainlink Functions ────────────────────────────────────────────────────────
# 1. Create subscription at https://functions.chain.link (Sepolia)
# 2. Top up with LINK: https://faucets.chain.link
# 3. Run: npx hardhat run scripts/upload-secrets.ts --network sepolia
#    → prints CHAINLINK_SECRETS_SLOT_ID and CHAINLINK_SECRETS_VERSION
CHAINLINK_SUBSCRIPTION_ID=
CHAINLINK_SECRETS_SLOT_ID=0
CHAINLINK_SECRETS_VERSION=

# ── 0G Compute ────────────────────────────────────────────────────────────────
# API key for 0G Compute (TeeML verifiable inference)
# Stored as DON-hosted secret — never exposed on-chain
# Get key: https://hub.0g.ai / dashboard
ZG_API_KEY=
ZG_BASE_URL=https://router-api-testnet.integratenetwork.work/v1

# ── Frontend (copy to frontend/.env.local after deploy) ───────────────────────
# These are printed automatically by deploy-sepolia.ts
NEXT_PUBLIC_FUND_VAULT_ADDRESS=
NEXT_PUBLIC_FUND_TOKEN_ADDRESS=
NEXT_PUBLIC_INVESTMENT_MANAGER_ADDRESS=
NEXT_PUBLIC_OMNI_ORACLE_ADDRESS=
NEXT_PUBLIC_AUDIT_TRAIL_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
